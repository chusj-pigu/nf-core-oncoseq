nextflow_workflow {

    name "Test Workflow CNV_CALLING"
    script "subworkflows/local/variant_calling/cnv_calling.nf"
    workflow "CNV_CALLING"

    test("Should run without failures") {

        when {
            params {
                // define parameters here. Example:
                delly_bin_size=500000
                qdnaseq_binsize=500
            }
            workflow {
                """
                // define inputs of the workflow here. Example:
                ch_bam0 = channel.fromPath("${projectDir}/test_data/realistic_data/435807_SISJ1551_T_asWGS_ALL_435825_1T_hg38.indexed.bam")
                ch_bai0 = channel.fromPath("${projectDir}/test_data/realistic_data/435807_SISJ1551_T_asWGS_ALL_435825_1T_hg38.indexed.bam.bai")
                ch_bam1 = channel.fromPath("${projectDir}/test_data/realistic_data/435807_SISJ1551_T_asWGS_ALL_435825_1T_hg38.indexed.bam")
                ch_bai1 = channel.fromPath("${projectDir}/test_data/realistic_data/435807_SISJ1551_T_asWGS_ALL_435825_1T_hg38.indexed.bam.bai")
                ch_input0 = ch_bam0
                    .combine(ch_bai0)
                    .map { bam, bai ->
                        tuple(id:'HCC1395',bam,bai)}
                ch_input1 = ch_bam1
                    .combine(ch_bai1)
                    .map { bam, bai ->
                        tuple(id:'HG003',bam,bai)}

                input[0] = ch_input0.mix(ch_input1)
                ref = channel.fromPath("${projectDir}/test_data/references/hg38.fa.gz")
                ref_index = channel.fromPath("${projectDir}/test_data/references/hg38.fa.gz")
                input[1] = ref
                    .combine(ref_index)
                    .map { ref, ref_fai ->
                        tuple(id:"hg38", ref, ref_fai) }
                """
            }
        }

        then {
            assert workflow.success
        }

    }

}
