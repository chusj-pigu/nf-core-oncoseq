params.validation_help_before_text = """
-\033[2m----------------------------------------------------\033[0m-
                                        \033[0;32m,--.\033[0;30m/\033[0;32m,-.\033[0m
\033[0;34m        ___     __   __   __   ___     \033[0;32m/,-._.--~\'\033[0m
\033[0;34m  |\\ | |__  __ /  ` /  \\ |__) |__         \033[0;33m}  {\033[0m
\033[0;34m  | \\| |       \\__, \\__/ |  \\ |___     \033[0;32m\\`-._,-`-,\033[0m
                                        \033[0;32m`._,._,\'\033[0m
\033[0;35m  nf-core/oncoseq ${params.pipeline_version}\033[0m
-\033[2m----------------------------------------------------\033[0m-
"""

params.validation_help_after_text = """${params.pipeline_doi ? "\n* The pipeline\n" : ""}${params.pipeline_doi.tokenize(",").collect { doi -> "    https://doi.org/${doi.trim().replace('https://doi.org/','')}" }.join("\n")}${params.pipeline_doi ? "\n" : ""}
* The nf-core framework
    https://doi.org/10.1038/s41587-020-0439-x

* Software dependencies
    https://github.com/nf-core/oncoseq/blob/master/CITATIONS.md
"""

validation {
    defaultIgnoreParams = ["genomes"]
    monochromeLogs = params.monochrome_logs
    help {
        enabled = true
        command = "nextflow run nf-core/oncoseq -profile <docker/singularity/.../institute> --input samplesheet.csv --outdir <OUTDIR>"
        fullParameter = "help_full"
        showHiddenParameter = "show_hidden"
        beforeText = params.validation_help_before_text
        afterText = params.validation_help_after_text
    }
    summary {
        beforeText = params.validation_help_before_text
        afterText = params.validation_help_after_text
    }
}
