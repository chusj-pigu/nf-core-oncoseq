{
    "name": "nfcore",
    "image": "nfcore/gitpod:latest",
    "remoteUser": "gitpod",
    "runArgs": ["--privileged", "--network=host"],
    "remoteEnv": {
        // Nextflow installation version
        "NXF_HOME": "/workspaces/nf-core-oncoseq/.nextflow",
        "NXF_EDGE": "0",
        "NXF_VER": "26.04.4",
        "NXF_SYNTAX_PARSER": "v2",
        // Other env vars
        "HOST_PROJECT_PATH": "/workspaces/nf-core-oncoseq",
        "SHELL": "/bin/bash" // Ush bash
    },

    // Configure tool-specific properties.
    "customizations": {
        // Configure properties specific to VS Code.
        "vscode": {
            // Set *default* container specific settings.json values on container create.
            "settings": {
                "python.defaultInterpreterPath": "/opt/conda/bin/python"
            },

            // Add the IDs of extensions you want installed when the container is created.
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "nf-core.nf-core-extensionpack",
                "antfu.browse-lite"
            ]
        }
    },
    "postStartCommand": "sudo chown gitpod:gitpod /opt/conda/bin/nextflow"
}

