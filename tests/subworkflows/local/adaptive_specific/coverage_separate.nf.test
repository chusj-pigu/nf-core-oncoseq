nextflow_workflow {

    name "Test Workflow COVERAGE_SEPARATE"
    script "subworkflows/local/adaptive_specific/coverage_separate.nf"
    workflow "COVERAGE_SEPARATE"

    test("Should run without failures") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
            }
            workflow {
                """
                // define inputs of the workflow here
                ch_bam0 = channel.fromPath("${projectDir}/test_data/variant_calling/snp_calling/input/HCC1395_tumor_chr17_demo.bam")
                ch_bai0 = channel.fromPath("${projectDir}/test_data/variant_calling/snp_calling/input/HCC1395_tumor_chr17_demo.bam.bai")
                ch_bam1 = channel.fromPath("${projectDir}/test_data/variant_calling/snp_calling/input/HG003_chr20_demo.bam")
                ch_bai1 = channel.fromPath("${projectDir}/test_data/variant_calling/snp_calling/input/HG003_chr20_demo.bam.bai")

                ch_input0 = ch_bam0
                    .combine(ch_bai0)
                    .map { bam, bai -> tuple([id:'HCC1395'], bam, bai) }
                ch_input1 = ch_bam1
                    .combine(ch_bai1)
                    .map { bam, bai -> tuple([id:'HG003'], bam, bai) }

                input[0] = ch_input0.mix(ch_input1)

                ch_bed0 = channel.fromPath("${projectDir}/test_data/variant_calling/snp_calling/input/HCC1395.bed")
                    .map { bed -> tuple([id:'HCC1395'], bed) }
                ch_bed1 = channel.fromPath("${projectDir}/test_data/variant_calling/snp_calling/input/HG003.bed")
                    .map { bed -> tuple([id:'HG003'], bed) }

                ch_lf = channel.fromPath("${projectDir}/assets/panel_low_fidelity.txt")

                input[1] = ch_bed0.map { meta, bed -> tuple(meta, bed, 0)}.combine(ch_lf)
                    .mix(ch_bed1.map { meta, bed -> tuple(meta, bed, 0)}.combine(ch_lf))

                input[2] = ch_bed0.mix(ch_bed1)

                input[3] = "hg38"
                """
            }
        }

        then {
            assert workflow.success
        }

    }

}
