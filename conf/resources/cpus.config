process {
    // CPU Definitions
    withLabel:process_single_cpu {
        cpus = 1
    }
    withLabel:process_low_cpu {
        cpus = { params.check_max( 4 * task.attempt, 'cpus' ) }
    }
    withLabel:process_medium_low_cpu {
        cpus = { params.check_max( 10 * task.attempt, 'cpus' ) }
    }
    withLabel:process_medium_cpu {
        cpus = { params.check_max( 20 * task.attempt, 'cpus' ) }
    }
    withLabel:process_medium_high_cpu {
        cpus = { params.check_max( 35 * task.attempt, 'cpus' ) }
    }
    withLabel:process_high_cpu {
        cpus = { params.check_max( 60 * task.attempt, 'cpus' ) }
    }
}
