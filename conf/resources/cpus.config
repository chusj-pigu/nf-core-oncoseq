process {
    // CPU Definitions
    withLabel:process_single_cpu {
        cpus = 1
    }
    withLabel:process_low_cpu {
        cpus = {
            def requested = 4 * task.attempt
            try {
                Math.min(requested, params.max_cpus)
            } catch (all) {
                println "   ### ERROR ###   Max cpus '${params.max_cpus}' is not valid! Using default value: $requested"
                requested
            }
        }
    }
    withLabel:process_medium_low_cpu {
        cpus = {
            def requested = 10 * task.attempt
            try {
                Math.min(requested, params.max_cpus)
            } catch (all) {
                println "   ### ERROR ###   Max cpus '${params.max_cpus}' is not valid! Using default value: $requested"
                requested
            }
        }
    }
    withLabel:process_medium_cpu {
        cpus = {
            def requested = 20 * task.attempt
            try {
                Math.min(requested, params.max_cpus)
            } catch (all) {
                println "   ### ERROR ###   Max cpus '${params.max_cpus}' is not valid! Using default value: $requested"
                requested
            }
        }
    }
    withLabel:process_medium_high_cpu {
        cpus = {
            def requested = 35 * task.attempt
            try {
                Math.min(requested, params.max_cpus)
            } catch (all) {
                println "   ### ERROR ###   Max cpus '${params.max_cpus}' is not valid! Using default value: $requested"
                requested
            }
        }
    }
    withLabel:process_high_cpu {
        cpus = {
            def requested = 60 * task.attempt
            try {
                Math.min(requested, params.max_cpus)
            } catch (all) {
                println "   ### ERROR ###   Max cpus '${params.max_cpus}' is not valid! Using default value: $requested"
                requested
            }
        }
    }
}
