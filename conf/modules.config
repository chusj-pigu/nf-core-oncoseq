/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/program_outputs/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'BEDTOOLS_SLOP' {
        ext.args   = { "-l ${meta.padding} -r ${meta.padding}" }
        ext.prefix = { "${meta.id}.no_padding" }
    }

    withName: 'BEDTOOLS_MAKEWINDOWS' {
        ext.args   = "-w 1000000000"
    }

    withName: 'MOSDEPTH_BACKGROUND' {
        publishDir = [
            path: { "${params.outdir}/reports/mosdepth" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = "-n -F 1796 -Q 0"
    }

    withName: 'MOSDEPTH_NOFILT' {
        ext.args = "-n -F 1540 -Q 0"
    }

    withName: 'MOSDEPTH_PRIMARY' {
        publishDir = [
            path: { "${params.outdir}/reports/mosdepth" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = "-n -F 1796 -Q 0"
    }

    withName: 'MOSDEPTH_UNIQUE' {
        ext.args = "-n -F 1796 -Q 60"
    }

    withName: 'QUARTO_REPORT' {
        publishDir = [
            path: { "${params.outdir}/reports" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SAMTOOLS_TOFASTQ' {
        publishDir = [
            path: { "${params.outdir}/reads" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = "-T '*'"
    }

    withName: 'SAMTOOLS_TIME_FASTQ' {
        ext.args = "-T 'st'"
    }

    withName: 'CHOPPER' {
        publishDir = [
            path: { "${params.outdir}/reads" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args2 = "--maxlength ${params.max_length}"
    }

    withName: 'MINIMAP2_ALIGN' {
        publishDir = [
            path: { "${params.outdir}/alignments" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SAMTOOLS_INDEX_PHASED' {
        publishDir = [
            path: { "${params.outdir}/phasing" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'ENSEMBLVEP_DOWNLOAD' {
        publishDir = [
            path: {
                if (params.ref_cache) {
                    def refCache = new File(params.ref_cache)
                    refCache.isDirectory() ? refCache.toString() : refCache.getParent()
                }
                else {
                    "${params.outdir}"
                }
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SEQKIT_STATS' {
        publishDir = [
            path: { "${params.outdir}/reports/seqkit" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CLAIRS_TO_CALL' {
        ext.args = "--chunk_size 500000 --remove_intermediate_dir"
    }

    withName: 'CLAIR3_CALL' {
        ext.args = "--snp_min_af=0.05 --remove_intermediate_dir"
    }

    withName: 'DEEPSOMATIC' {
        ext.args = '--model_type=ONT_TUMOR_ONLY'
    }

    withName: 'WHATSHAP_PHASE' {
        publishDir = [
            path: { "${params.outdir}/variants/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = '--ignore-read-groups'
    }

    withName: 'WHATSHAP_HAPLOTAG' {
         publishDir = [
            path: { "${params.outdir}/phasing/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = '--ignore-read-groups --skip-missing-contigs'
    }


    withName: 'WHATSHAP_STATS' {
        publishDir = [
            path: { "${params.outdir}/phasing/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SNIFFLES' {
        ext.args = '--minsupport-auto-mult 0.05'
    }

    withName: 'STELLERATOR' {
        publishDir = [
            path: { "${params.outdir}/variants/SVs" },
            mode: params.publish_dir_mode,
            pattern: '*.vcf'
        ]
    }

    withName: 'QDNASEQ_CALL' {
        publishDir = [
            path: { "${params.outdir}/variants/CNVs/qdnaseq" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            // pattern: '*calls.vcf,*cov.pdf,*.png'
            pattern: '*'
        ]
    }

    withLabel: 'classy' {
        publishDir = [
            path: { "${params.outdir}/reports/tumor_classifiers" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
        ext.args = params.cfdna ? '--min-read-length 20 --threshold-figure-colors' : '--threshold-figure-colors'
    }

    withLabel: 'PARSE_JSON_COMBINED' {
        publishDir = [
            path: { "${params.outdir}/reports/tumor_classifiers" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'DELLY_CNV' {
        publishDir = [
            path: { "${params.outdir}/variants/CNVs/delly" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'ICHORCNA' {
        publishDir = [
            path: { "${params.outdir}/variants/CNVs/ichorcna" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'BCFTOOLS_QUERY_CNV' {
        publishDir = [
            path: { "${params.outdir}/variants/CNVs/delly" },
            mode: params.publish_dir_mode
        ]
        ext.args = "-f '%CHROM\\t%POS\\t%INFO/END\\t%ID[\\t%RDCN]\\n'"
        ext.suffix = "bed"

    }

    withName: 'BCFTOOLS_QUERY_SNP' {
        ext.args = "-f '%CHROM\\t%POS\\t%REF\\t%ALT\\t%QUAL\\t%FILTER\\t%INFO/CSQ\\t[%DP]\\t[%AD]\\n'"
        ext.suffix = "bed"
    }

    withName: 'BCFTOOLS_RM_HEADER' {
        ext.args = '-H'
    }

    withName: 'BCFTOOLS_SORT' {
        ext.args = '-Oz -W=tbi'
    }

    withName: 'BCFTOOLS_SNP_UNPHASED_CONCAT' {
        ext.args = '-a -D -Oz --write-index=tbi'
        publishDir = [
            path: { "${params.outdir}/variants" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'BCFTOOLS_SNP_PHASED_CONCAT' {
        ext.args = '-a -D -Oz --write-index=tbi'
    }

    withName: 'BCFTOOLS_CONCAT' {
        ext.args = '-a -D --write-index=tbi -Oz'
    }

    withName: 'BEDTOOLS_INTERSECT' {
        ext.args = '-wa'
    }

    withName: 'BCFTOOLS_FILTER_SNP' {
        ext.args = "-W=tbi -Oz -i 'FILTER=\"PASS\" || FILTER=\"GERMLINE\"'"
    }

    withName: 'BCFTOOLS_COUNT' {
        ext.args = '-H'
    }

    withName: 'BCFTOOLS_FILTER_SV' {
        ext.args = "-i 'FORMAT/DV > 4' -W=tbi -Oz"
    }

    withName: 'ENSEMBLVEP_VEP' {
        publishDir = [
            path: { "${params.outdir}/variants" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (!(filename =~ /\.vcf\.gz(\.tbi)?$/)) return null
                def name = filename.toLowerCase()
                if (name =~ /clairsto|clair3|deepsomatic/) return "SNPs/${filename}"
                if (name =~ /sniffles|severus/)            return "SVs/${filename}"
                return filename
            }
        ]
        ext.args = '--offline --vcf --everything'
    }

    withName: 'ENSEMBLVEP_DOWNLOAD' {
        publishDir = [
            path: {
                if (params.vep_cache) {
                    vep_cache
                }
                else if (params.ref_cache) {
                    refCache.isDirectory() ? refCache.toString() : refCache.getParent()
                }
                else {
                    "${params.outdir}"
                }
            },
            mode: params.publish_dir_mode
        ]
        // VEP cache downloads require internet access, which compute nodes may not have.
        executor = 'local'
        // Keep the launch-host cache bootstrap lightweight.
        cpus = 1
        memory = 4.GB
        array = 0
        ext.args = '--AUTO c --NO_BIOPERL --NO_HTSLIB --NO_TEST --NO_UPDATE'
    }

    withName: 'ENSEMBLVEP_FILTERVEP' {
        publishDir = [
            path: { "${params.outdir}/variants" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                def name = filename.toLowerCase()
                if (name =~ /clairsto|clair3|deepsomatic/) return "SNPs/${filename.replace('.vcf','_filt.vcf')}"
                if (name =~ /sniffles|severus/)            return "SVs/${filename.replace('.vcf','_filt.vcf')}"
                return filename.replace('.vcf','_filt.vcf')
            },
        ]
        ext.args = "--filter \"${params.filtervep_expression}\""
    }

    withName: 'SAMTOOLS_COUNT_READS' {
        ext.args = "-d ML"
    }

    withName: 'SAMTOOLS_FILTER_LEN' {
        ext.args = "-e 'qlen <= ${params.max_length}'"
    }

    withName: 'PHARMCAT_REPORTER' {
        publishDir = [
            path: { "${params.outdir}/variants/pharmcat" },
            mode: params.publish_dir_mode
        ]
    }
}
