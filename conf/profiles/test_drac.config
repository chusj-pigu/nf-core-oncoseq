process {
    array = 2
    executor = 'slurm'
    time = {
        def requested = 1.h * task.attempt
        def maximum = params.max_time as nextflow.util.Duration
        requested.compareTo(maximum) == 1 ? maximum : requested
    }
    memory = {
        def requested = 2.GB * task.attempt
        def maximum = params.max_memory as nextflow.util.MemoryUnit
        requested.compareTo(maximum) == 1 ? maximum : requested
    }
    cpus = { Math.min(1 * task.attempt, params.max_cpus as int) }
    withLabel:process_gpu {
        containerOptions = "--nv"
        clusterOptions = "--gpus-per-node=1"
    }
}

executor {
    pollInterval = '60 sec'
    submitRateLimit = '60/1min'
    queueSize = 100
}

params {
        max_memory='249G'
        max_cpus=64
        max_time='168h'
        publish_dir_mode = 'link'
}
apptainer {
        enabled=true
        autoMounts=true
        runOptions = "-B /project/ctb-noncodo/Platform/references"
        libraryDir = "${env('HOME')}/scratch/apptainer_lib/"
        cacheDir = "${env('HOME')}/scratch/apptainer_cache/"
}
