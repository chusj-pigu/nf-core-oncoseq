/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run nf-core/oncoseq -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    errorStrategy = { task.attempt < 2 ? 'retry' : 'ignore' }
    maxRetries = 1
    resourceLimits = [
        cpus: 8,
        memory: '30.GB',
        time: '3.h'
    ]
}

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full test dataset to check pipeline function in realtime'
    outdir = 'test_out'
    // Input data for full size test
    // TODO nf-core: Specify the paths to your full test data ( on nf-core/test-datasets or directly in repositories, e.g. SRA)
    // TODO nf-core: Give any required params for the test so that command line flags are not needed
    input = params.pipelines_testdata_base_path + 'realistic_data/realtime_samplesheet.csv'
    // Fasta references
    // ref = params.pipelines_testdata_base_path + 'realistic_data/hg38.{fa,fa.fai}'
    // Bed file
    bed = params.pipelines_testdata_base_path + 'realistic_data/test.bed'
    //sv_targets = "${projectDir}/test_data/realistic_data/VPL_sv_targets_figeno.csv"
    clairsto_model             = 'ont_r10_dorado_sup_5khz_ssrs'
    basecall_model             = 'hac'
    maxForks = 1
    publish_dir_mode = 'copy'
    minqs = 8
    padding = 20000
    clin_database = "${projectDir}/test_data/realistic_data/hg38_clinvar.vcf.gz"
    low_fidelity = "${projectDir}/assets/NOLIST"
    adaptive = true
    skip_mapping = true
    realtime = 1
    ref = "${projectDir}/test_data/realistic_data/hg38.fa"
    //ref_t2t = params.pipelines_testdata_base_path + 'realistic_data/chm13v2.0.fa.gz'
}

apptainer {
    enabled=true
    autoMounts=true
    runOptions = '-C --writable-tmpfs'
    cacheDir = "/tmp/apptainer/cache"
}
