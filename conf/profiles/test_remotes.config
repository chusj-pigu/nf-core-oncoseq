/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple
    pipeline test.

    Usage:
        nextflow run nf-core/oncoseq -profile test,<docker/singularity> \
            --outdir <OUTDIR>
--------------------------------------------------------------------------------
*/

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Process Resource Limits
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/
process {
    errorStrategy = { task.attempt < 2 ? 'retry' : 'ignore' }
    maxRetries = 1
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Pipeline Parameter Overrides
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/
params {
    adaptive = true
    config_profile_name = 'Test profile'
    config_profile_description =
        'Minimal test dataset to check pipeline function'
    outdir = 'test_out'

    // Input data
    input =
        params.pipelines_testdata_base_path + 'basecalling/samplesheets/' +
        'samplesheet2.csv'
    clairsto_model = 'ont_r10_dorado_sup_5khz_ssrs'
    basecall_model = 'dna_r10.4.1_e8.2_400bps_hac@v5.2.0_5mC_5hmC@v1'
    device = null

    publish_dir_mode = 'copy'
    minqs = 8
    bed = params.pipelines_testdata_base_path +
        'adaptive/2025-02-05-CHUSJ-Panel-20kb-LP.bed'
    max_cpus = 4
    max_memory = '15.GB'
    max_time = '1.h'
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Apptainer Options
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/
apptainer {
    enabled = true
    autoMounts = true
    runOptions = '--writable-tmpfs'
    cacheDir = '/tmp/apptainer/cache'
}
