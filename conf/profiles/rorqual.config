process {
    withLabel: 'local' {
        executor = 'local'
        maxForks = 3   // or whatever makes sense for your machine
        errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'ignore' }
    }
    withLabel: '!local' {
        executor = 'slurm'
        array = 96
        errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'ignore' }
    }
    withLabel:process_gpu {
        containerOptions = "--nv"
        clusterOptions = "--gpus-per-node=h100:2"
    }
}

executor {
  $slurm {
      pollInterval    = '60 sec'
      submitRateLimit = '60/1min'
      queueSize       = 100
  }
}

params {
        max_memory='249G'
        max_cpus=64
        max_time='168h'
        publish_dir_mode = 'link'
}
apptainer {
        enabled=true
        autoMounts=true
        runOptions = "--writable-tmpfs"
        libraryDir = "/project/rpp-lavvin00/platform/nanopore/references/apptainer/cache"
        cacheDir = "/project/rpp-lavvin00/platform/nanopore/references/apptainer/cache"
        pullTimeout = '60 min'
}
