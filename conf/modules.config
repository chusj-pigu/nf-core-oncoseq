/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/program_outputs/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'MOSDEPTH_ADAPTIVE' {
        publishDir = [
            path: { "${params.outdir}/reports/mosdepth" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = "-n"
    }

    withName: 'MOSDEPTH_GENERAL' {
        publishDir = [
            path: { "${params.outdir}/reports/mosdepth" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = "-n"
    }

    withName: 'QUARTO_REPORT' {
        publishDir = [
            path: { "${params.outdir}/reports" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SAMTOOLS_TOFASTQ' {
        publishDir = [
            path: { "${params.outdir}/reads" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = "-T '*'"
    }

    withName: 'SAMTOOLS_TIME_FASTQ' {
        ext.args = "-T 'st'"
    }

    withName: 'CHOPPER_LENGTH' {
        publishDir = [
            path: { "${params.outdir}/reads" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SAMTOOLS_INDEX_FULL' {
        publishDir = [
            path: { "${params.outdir}/alignments" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SAMTOOLS_INDEX_PHASED' {
        publishDir = [
            path: { "${params.outdir}/phasing" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SAMTOOLS_FAIDX' {
        publishDir = [
            path: { params.ref_cache != null ? "${params.ref_cache}" : "${params.outdir}/cache"},
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SEQKIT_STATS' {
        publishDir = [
            path: { "${params.outdir}/reports/seqkit" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BCFTOOLS_CONCAT' {
        ext.args = '-a -D'
    }

    withName: 'CLAIRS_TO_CALL' {
        ext.args = "--chunk_size 500000 --remove_intermediate_dir"
    }

    withName: 'CLAIR3_CALL' {
        ext.args = "--snp_min_af=0.05 --remove_intermediate_dir"
    }

    withName: 'SAMTOOLS_SEPARATE_BED' {
        ext.args = "-b -x MM,ML"
    }

    withName: 'CRAMINO_STATS' {
        publishDir = [
            path: { "${params.outdir}/reports/cramino" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BCFTOOLS_CONCAT' {
        ext.args = '-a -D'
    }

    withName: 'BCFTOOLS_MPILEUP' {
        ext.args = '-Ou --min-BQ 0'
    }

    withName: 'BCFTOOLS_CALL' {
        ext.args = '-mv -Oz'
    }

    withName: 'WHATSHAP_PHASE' {
        publishDir = [
            path: { "${params.outdir}/variants/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }


    withName: 'WHATSHAP_STATS' {
        publishDir = [
            path: { "${params.outdir}/phasing/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SNIFFLES_CALL' {
        ext.args = '--minsupport-auto-mult 0.05'
    }

    withName: 'BGZIP_VCF' {
        publishDir = [
            path: { "${params.outdir}/variants/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename.contains('sv') ? filename : null }
        ]
    }

    withName: 'QDNASEQ_CALL' {
        publishDir = [
            path: { "${params.outdir}/variants/qdnaseq" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            // pattern: '*calls.vcf,*cov.pdf,*.png'
            pattern: '*'
        ]
    }

    withName: 'SNPEFF_ANNOTATE' {
        ext.args = '-q'
    }

    withName: 'SNPSIFT_ANNOTATE' {
        ext.args = '-q'
    }

    withName: 'SUBCHROM_CALL_WGS' {
        publishDir = [
            path: { "${params.outdir}/variants/subchrom" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'SUBCHROM_CALL_PANEL' {
        publishDir = [
            path: { "${params.outdir}/variants/subchrom" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'SV_PROCESS' {
        publishDir = [
            path: { "${params.outdir}/variants" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'MODKIT_ADJUST' {
        ext.args = '--convert h m'
    }

    withLabel: 'classy' {
        publishDir = [
            path: { "${params.outdir}/reports/tumor_classifiers" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
        ext.args = params.cfdna ? '--min-read-length 20' : ''
    }

    withName: 'TIDEHUNTER_FASTQ' {
        ext.args = '-c 3 -p 100 --min-len 50'
    }

    withName: 'TIDEHUNTER_TAB' {
        ext.args = '-c 3 -p 100 --min-len 50'
    }

    withName: 'PIGZ_FA' {
        publishDir = [
            path: { "${params.outdir}/reads" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'DELLY_CNV' {
        publishDir = [
            path: { "${params.outdir}/variants/delly" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'ICHORCNA' {
        publishDir = [
            path: { "${params.outdir}/variants/ichorcna" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'BCFTOOLS_QUERY_CNV' {
        publishDir = [
            path: { "${params.outdir}/variants/delly" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
        ext.args = "-f '%CHROM\\t%POS\\t%INFO/END\\t%ID[\\t%RDCN]\\n'"

    }

    withName: 'BCFTOOLS_QUERY_SNP' {
        ext.args = "-f '%CHROM\\t%POS\\t%REF\\t%ALT\\t%QUAL\\t%FILTER\\t%INFO/CSQ\\t[%DP]\\t[%AD]\\n'"
    }

    withName: 'BGZIP_VCF_FINAL' {
        publishDir = [
            path: { "${params.outdir}/variants" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'ENSEMBLVEP_VEP' {
        publishDir = [
            path: { "${params.outdir}/variants" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
        ext.args = '--offline --vcf --everything'
    }

    withName: 'ENSEMBLVEP_FILTERVEP' {
        publishDir = [
            path: { "${params.outdir}/variants" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename.replace('.vcf','_filt.vcf') },
        ]
        ext.args = "--filter \"${params.filtervep_expression}\""
    }

    withName: 'SAMTOOLS_COUNT_READS' {
        ext.args = "-d ML"
    }

    withName: 'SAMTOOLS_FILTER' {
        ext.args = "-e 'qlen <= ${params.max_length}'"
    }
}
