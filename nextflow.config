/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/oncoseq Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
--------------------------------------------------------------------------------
*/

// Load parameters config
includeConfig 'conf/params.config' // Pipeline parameters

// Load base config for all pipelines
includeConfig 'conf/base.config' // Base settings

// Load resource configs
includeConfig 'conf/resources/cpus.config' // CPU resources
includeConfig 'conf/resources/gpus.config' // GPU resources
includeConfig 'conf/resources/memory.config'  // Memory resources
includeConfig 'conf/resources/time.config' // Time resources
includeConfig 'conf/resources/extra.config' // Extra configuration options

// Load nf-core profiles
includeConfig 'conf/profiles/nf-core-defaults.config'
// nf-core default profiles

// Profile definitions for different environments
profiles {
    test {
        includeConfig 'conf/profiles/test.config'
    } // Minimal test
    test_fastq {
        includeConfig 'conf/profiles/test_fastq.config'
    } // Fastq test
    test_full {
        includeConfig 'conf/profiles/test_full.config'
    } // Full test
    test_full_ts {
        includeConfig 'conf/profiles/test_full_time_series.config'
    } // Full test with time series
    test_remotes {
        includeConfig 'conf/profiles/test_remotes.config'
    } // Remote assets test
    test_realtime { includeConfig 'conf/profiles/test_realtime.config'         }
    test_full_wgs { includeConfig 'conf/profiles/test_full_wgs.config'         }
    test_cfdna    { includeConfig 'conf/profiles/test_cfdna.config'            }
    narval {
        includeConfig 'conf/profiles/narval.config'
    } // DRAC Narval cluster
    rorqual {
        includeConfig 'conf/profiles/rorqual.config'
    } // DRAC Rorqual cluster
    nibi {
        includeConfig 'conf/profiles/nibi.config'
    } // DRAC Nibi cluster
    test_drac {
        includeConfig 'conf/profiles/test_drac.config'
    } // DRAC test
    mpgi_local {
        includeConfig 'conf/profiles/mpgi_local.config'
    } // Local MPGI
    ichor_hg38 {
        includeConfig 'conf/profiles/ichor_hg38.config'
    } // Parameters for IchorCNA with hg38 reference
    ichor_hg19 {
        includeConfig 'conf/profiles/ichor_hg19.config'
    } // Parameters for IchorCNA with hg19 reference
}

// Load nf-core custom profiles from different Institutions
// (if not offline)
includeConfig !System.getenv('NXF_OFFLINE') && params.custom_config_base ?
    "${params.custom_config_base}/nfcore_custom.config" :
    '/dev/null'

// Optionally load pipeline-specific custom profiles (commented out)
// includeConfig !System.getenv('NXF_OFFLINE') && params.custom_config_base ?
//     "${params.custom_config_base}/pipeline/oncoseq.config" :
//     '/dev/null'

// Load default, manifest, and validation configs
includeConfig 'conf/defaults.config' // Default values
includeConfig 'conf/manifest.config' // Manifest metadata
includeConfig 'conf/validation.config' // Parameter validation

// Nextflow plugins
plugins {
    id 'nf-schema@2.3.0' // Validation and sample sheet input-channel creation
}

// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'

process.shell = [
    "bash", "-euo", "pipefail"
]
