process {
    withLabel: 'local' {
        executor = 'local'
        maxForks = 3   // or whatever makes sense for your machine
    }
    withLabel: '!local' {
        executor = 'slurm'
        array = 96
        errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'ignore' }
    }
    withLabel:process_gpu {
        containerOptions = "--nv"
        clusterOptions = "--gpus-per-node=a100:4"
    }
    withLabel:process_gpu_clair3 {
        containerOptions = params.clair3_gpu ? "--nv" : ""
        clusterOptions = params.clair3_gpu ? "--gpus-per-node=a100:4" : ""
    }
}

executor {
  $slurm {
      pollInterval    = '60 sec'
      submitRateLimit = '60/1min'
      queueSize       = 100
  }
}

params {
        max_memory='249G'
        max_cpus=64
        max_time='168h'
        publish_dir_mode = 'link'
}
apptainer {
        enabled=true
        autoMounts=true
        runOptions = "-C -B /project/ctb-noncodo/Platform/references --writable-tmpfs"
        libraryDir = "/project/ctb-noncodo/Platform/references/apptainer/cache"
        cacheDir = "/project/ctb-noncodo/Platform/references/apptainer/cache"
        pullTimeout = '60 min'
}
